Meta.DisplayName=Alchemy Factory Server
Meta.Description=Dedicated Server for Alchemy Factory
Meta.OS=Windows, Linux
Meta.Arch=x86_64
Meta.Author=gu4rd
Meta.URL=https://steampowered.com
Meta.DisplayImageSource=steam:3669570
Meta.ConfigManifest=alchemy-factory.json
Meta.MetaConfigManifest=alchemy-factory.metadata.json
Meta.ConfigRoot=alchemy-factory.kvp
Meta.MinAMPVersion=2.4.6.6
Meta.SpecificDockerImage=cubecoders/ampbase:xvfb
Meta.DockerRequired=True
Meta.ContainerPolicy=Supported
Meta.ConfigVersion=1
Meta.AppConfigId=cd3a7e82-9f49-4f6a-92fe-fbcf96be19f2

App.DisplayName=Alchemy Factory
App.RootDir=./alchemy-factory/
App.BaseDirectory=./alchemy-factory/4550060/
App.StoresSupported=Steam
App.StoreSpecificSettings={"Steam": {"AppId": "4550060"}}
App.StoreDownloadLocations={"Steam": "4550060"}
App.ExecutableWin=4550060/AlchemyFactoryServer.exe
App.ExecutableLinux=/usr/bin/xvfb-run
App.WorkingDir=4550060
App.LinuxCommandLineArgs=-a wine "./AlchemyFactoryServer.exe" -port 7780 -log
App.CommandLineArgs={{$PlatformArgs}} {{$FormattedArgs}}
App.EnvironmentVariables={"LD_LIBRARY_PATH":"{{$FullBaseDir}}linux64:{{$FullRootDir}}linux64:%LD_LIBRARY_PATH%","SteamAppId":"3669570","WINEPREFIX":"{{$FullRootDir}}.wine","WINEARCH":"win64","WINEDEBUG":"-all"}
App.ExitMethod=OS_CLOSE
App.ExitTimeout=30
App.ExitString=stop
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.Ports=[{"Name": "MainGamePort", "Description": "Alchemy Factory Game Port", "DefaultSetting": 7780, "Protocol": "UDP"}]
App.PrimaryApplicationPortRef=MainGamePort
App.MaxUsers=8
App.AdminMethod=STDIO
App.UpdateSources=[{"UpdateStageName": "Alchemy Factory Windows Server Download", "UpdateSourcePlatform": "Windows", "UpdateSource": "SteamCMD", "UpdateSourceData": "4550060", "UpdateSourceArgs": "", "ForcedDownloadPlatform": "Windows"}]
App.PreStartStages=[]
App.SteamUpdateAnonymousLogin=True
App.SmartExcludeSupported=True
App.ApplicationReadyMode=Immediate
